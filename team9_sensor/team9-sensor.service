[Unit]
Description=Team 9 climate sensor BLE beacon (ENS160 + AHT21)
After=bluetooth.service time-sync.target
Wants=bluetooth.service time-sync.target

[Service]
Type=simple
WorkingDirectory=/home/rasp/team9_sensor
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStart=/usr/bin/python3 -u /home/rasp/team9_sensor/ble_beacon.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
