<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ledger_title"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/ledger_description"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/ledgerSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/surface"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ledgerSendButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginStart="0dp"
            android:text="@string/ledger_send_now"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ledgerRetryButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginEnd="0dp"
            android:enabled="false"
            android:text="@string/ledger_retry_failed"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ledgerImportButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginStart="0dp"
            android:text="@string/ledger_import"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ledgerSaveButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginEnd="0dp"
            android:text="@string/ledger_save"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ledgerFilterAll"
            style="@style/BottomTab"
            android:text="@string/ledger_filter_all"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ledgerFilterPending"
            style="@style/BottomTab"
            android:text="@string/ledger_filter_pending"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ledgerFilterFailed"
            style="@style/BottomTab"
            android:text="@string/ledger_filter_failed"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ledgerFilterUploaded"
            style="@style/BottomTab"
            android:text="@string/ledger_filter_uploaded"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ledgerFilterNoData"
            style="@style/BottomTab"
            android:text="@string/ledger_filter_no_data"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ledger_list_hint"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <ListView
        android:id="@+id/ledgerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />
</LinearLayout>
