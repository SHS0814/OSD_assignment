<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/archive_title"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/archive_description"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/archiveSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/surface"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveSendButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginStart="0dp"
            android:text="@string/archive_send_now"
            android:textSize="12sp" />

        <Button
            android:id="@+id/archiveRetryButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginEnd="0dp"
            android:enabled="false"
            android:text="@string/archive_retry_failed"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveImportButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginStart="0dp"
            android:text="@string/archive_import"
            android:textSize="12sp" />

        <Button
            android:id="@+id/archiveSaveButton"
            style="@style/ControlButton"
            android:layout_height="46dp"
            android:layout_marginEnd="0dp"
            android:text="@string/archive_save"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/archiveFilterAll"
            style="@style/BottomTab"
            android:text="@string/archive_filter_all"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/archiveFilterPending"
            style="@style/BottomTab"
            android:text="@string/archive_filter_pending"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/archiveFilterFailed"
            style="@style/BottomTab"
            android:text="@string/archive_filter_failed"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/archiveFilterUploaded"
            style="@style/BottomTab"
            android:text="@string/archive_filter_uploaded"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/archiveFilterNoData"
            style="@style/BottomTab"
            android:text="@string/archive_filter_no_data"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/archive_list_hint"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <ListView
        android:id="@+id/archiveList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />
</LinearLayout>
